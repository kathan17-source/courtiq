COURTIQ_ENV=production
# Set to the exact public origin for cross-origin clients. Same-origin CourtIQ needs no CORS entry.
COURTIQ_CORS_ORIGINS=
PORT=8000
COURTIQ_MODEL_VERSION=courtiq-v2-surface-elo
COURTIQ_MODEL_ARTIFACT=output/models/courtiq_model_atp.json
COURTIQ_ALLOW_DEMO=false
COURTIQ_REQUEST_BODY_LIMIT_BYTES=2097152
COURTIQ_UPLOAD_LIMIT_BYTES=83886080
COURTIQ_VIDEO_MAX_DURATION_SECONDS=30
COURTIQ_VIDEO_MAX_PIXELS=8294400
COURTIQ_VIDEO_MAX_FRAMES=1800
COURTIQ_VIDEO_MAX_FPS=120
COURTIQ_MAX_SIMULATIONS=10000
COURTIQ_RATE_LIMIT_PER_MINUTE=120
COURTIQ_LOG_LEVEL=INFO
GEMINI_API_KEY=
COURTIQ_GEMINI_MODEL=gemini-3.5-flash
COURTIQ_GEMINI_TIMEOUT_SECONDS=12
